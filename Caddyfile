# Caddy obtains and renews the TLS certificate on its own; there is no certbot
# step and no renewal cron to forget.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Source videos are large and renders are streamed back through the app, so the
	# defaults (which assume ordinary page traffic) would cut both off.
	request_body {
		max_size 2GB
	}

	reverse_proxy web:3000 {
		# A 25-minute render is requested through the app, not proxied, but uploads
		# and download streams still need far longer than the 60s default.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The app renders no third-party frames and should not be framed itself.
		X-Frame-Options DENY
	}

	log {
		output stdout
		format console
	}
}
