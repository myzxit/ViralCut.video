# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every AI key is optional — leave them blank and the
# pipeline runs in mock mode: real ffmpeg rendering, placeholder script and voice.
# ---------------------------------------------------------------------------

# Core services (docker compose sets these for you)
DATABASE_URL="postgresql://viralcut:viralcut@localhost:5432/viralcut"
REDIS_URL="redis://localhost:6379"

# Where uploads, intermediates, and renders live
STORAGE_DIR="./storage"

# Auth.js — generate the secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Google sign-in. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional email sign-in instead of (or alongside) Google
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="ViralCut <no-reply@example.com>"

# ---------------------------------------------------------------------------
# AI providers — all optional
# ---------------------------------------------------------------------------

# Covers transcription, script writing, and speech synthesis in one key.
OPENAI_API_KEY=""

# Set to 1 to force mock providers even when keys are present.
FORCE_MOCK_PROVIDERS=""

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

MAX_UPLOAD_BYTES="2147483648"
MAX_SOURCE_SECONDS="14400"
RETENTION_DAYS="14"
WORKER_CONCURRENCY="2"
